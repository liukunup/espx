menu "ESPX Configuration"

    config ESPX
        bool "Enable ESPX"
        default y

    config DEVICE_NAME
        string "Device Name"
        default "ESPX"
        depends on ESPX

    config FIRMWARE_VERSION
        string "Firmware Version"
        default "1.0.0"
        depends on ESPX

    config MFG_TEST_GPIO
        int "Manufacturing Test trigger GPIO (-1 = disabled)"
        default -1
        depends on ESPX
        help
            GPIO held LOW at boot to enter manufacturing test mode.

            Set to -1 (default) to disable the boot-time GPIO trigger.

            WARNING: do not use a strapping pin (GPIO0/GPIO3/GPIO45/GPIO46 on
            ESP32-S3). Holding GPIO0 low across reset makes the chip enter the
            ROM UART download mode, so the application never runs.

            With the trigger disabled, test mode is still reachable by holding
            the BOOT button for ~3 s while the application is running, from the
            Web UI, or over MQTT.

    config LED_GPIO
        int "Status LED GPIO (-1 = disabled)"
        default -1
        depends on ESPX
        help
            GPIO of a single WS2812 status LED driven by the led_driver
            component. Set to -1 (default) to disable it.

            Note: the ws2812 peripheral driver can also drive the same LED. Do
            not enable both on the same GPIO: they create separate RMT channels
            and will fight over the pin.

    config LED_STRIP_LENGTH
        int "LED Strip Length"
        default 1
        depends on ESPX
        help
            Number of LEDs in the strip

    config MQTT_BROKER_URL
        string "Default MQTT Broker URL"
        default "mqtt://localhost:1883"
        depends on ESPX
        help
            Used only when no broker has been configured through the Web UI,
            MQTT or factory data.

    config OTA_SERVER_URL
        string "Default OTA Server URL"
        default ""
        depends on ESPX

    # =====================================================================
    # Wi-Fi provisioning
    # =====================================================================

    choice ESPX_PROV_TRANSPORT
        bool "Provisioning transport"
        default ESPX_PROV_TRANSPORT_BLE
        help
            How an unprovisioned device receives Wi-Fi credentials.

            BLE  - phone app / Bluetooth. Default. No access point is created,
                   so the device exposes no open network and has no IP until it
                   joins the configured Wi-Fi.
            SoftAP - the device raises its own access point and is configured
                   over HTTP. Useful when no BLE-capable client is available.
                   Note: during provisioning the config UI is reachable by
                   anyone in radio range (see docs/ARCHITECTURE.md limitation 9).

            Either way, a device carrying pre-provisioned credentials
            (network.wifi_ssid in factory data) joins that network directly and
            never starts the provisioning service.

        config ESPX_PROV_TRANSPORT_BLE
            bool "BLE"
            select BT_ENABLED
            depends on !IDF_TARGET_ESP32S2

        config ESPX_PROV_TRANSPORT_SOFTAP
            bool "SoftAP"
            select LWIP_IPV4
    endchoice

    config ESPX_PROV_TRANSPORT
        int
        default 1 if ESPX_PROV_TRANSPORT_BLE
        default 2 if ESPX_PROV_TRANSPORT_SOFTAP

    choice ESPX_PROV_SECURITY_VERSION
        bool "Provisioning security version"
        default ESPX_PROV_SECURITY_VERSION_1
        help
            Protocomm security for the provisioning session.
            Security 1 (X25519 + proof-of-possession) is what the Espressif
            provisioning apps use by default and needs only a PoP string.
            Security 2 (SRP6a) needs a per-device salt/verifier.

        config ESPX_PROV_SECURITY_VERSION_0
            bool "Security 0 (no security, plain text)"
            select ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0

        config ESPX_PROV_SECURITY_VERSION_1
            bool "Security 1 (X25519 + PoP)"
            select ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1

        config ESPX_PROV_SECURITY_VERSION_2
            bool "Security 2 (SRP6a)"
            select ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2
    endchoice

    config ESPX_PROV_POP
        string "Proof of possession (Security 1)"
        default "abcd1234"
        depends on ESPX_PROV_SECURITY_VERSION_1
        help
            Shared secret the provisioning client must present.
            MUST be changed for production.

    config ESPX_PROV_SEC2_USERNAME
        string "SRP6a username (Security 2)"
        default "wifiprov"
        depends on ESPX_PROV_SECURITY_VERSION_2

    config ESPX_PROV_SEC2_PASSWORD
        string "SRP6a password (Security 2, development mode)"
        default "abcd1234"
        depends on ESPX_PROV_SECURITY_VERSION_2

    config ESPX_PROV_SEC2_DEV_MODE
        bool "Security 2 development mode (hard-coded salt/verifier)"
        default y
        depends on ESPX_PROV_SECURITY_VERSION_2
        help
            Uses a salt/verifier compiled into the firmware.
            NOT suitable for production: every device would share the same
            credentials. Disable and supply per-device values from the
            manufacturing partition for production builds.

    config ESPX_PROV_SOFTAP_PREFIX
        string "SoftAP SSID prefix"
        default "PROV_"
        depends on ESPX_PROV_TRANSPORT_SOFTAP
        help
            Final SSID is the prefix followed by the last three bytes of the
            station MAC.

    config ESPX_PROV_SHOW_QR
        bool "Print a provisioning QR code on the console"
        default y

    config ESPX_PROV_SHOW_POP_IN_QR
        bool "Include the PoP in the QR code"
        default y
        depends on ESPX_PROV_SECURITY_VERSION_1 && ESPX_PROV_SHOW_QR
        help
            Convenient during development. Disable for production: the QR code
            is then printed without the shared secret.

    config ESPX_PROV_ENABLE_APP_CALLBACK
        bool "Enable the application provisioning callback"
        default n
        help
            Runs a blocking callback for provisioning events, for advanced
            use-cases such as adjusting the station configuration.

    config ESPX_PROV_RESET_ON_FAILURE
        bool "Reset the provisioning state machine after repeated failures"
        default y

    config ESPX_PROV_CONNECTION_COUNT
        int "Station connection attempts before reset"
        default 5
        depends on ESPX_PROV_RESET_ON_FAILURE
        help
            Guards against endlessly retrying an unreachable AP or wrong
            credentials.

    config ESPX_PROV_REPROVISIONING
        bool "Allow re-provisioning after a successful setup"
        default n

endmenu
