# ESPX Configuration
CONFIG_ESPX=y
CONFIG_DEVICE_NAME="ESPX"
CONFIG_FIRMWARE_VERSION="1.0.0"
CONFIG_MFG_TEST_GPIO=0
CONFIG_LED_GPIO=48
CONFIG_LED_STRIP_LENGTH=1

# Flash Size - ESP32-S3 R16N8 typically has 8MB
CONFIG_ESPTOOLPY_FLASH_SIZE="8MB"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# BT enabled
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# HTTPS Server
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPS_SERVER_PORT=443
