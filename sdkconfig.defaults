# ============================================================
# ESPX firmware defaults  (ESP32-S3 R16N8 = 16MB flash, 8MB PSRAM)
# ============================================================

# --- Target (pins the chip so a deleted sdkconfig cannot reset it) ---
CONFIG_IDF_TARGET="esp32s3"

# --- ESPX ---
CONFIG_ESPX=y
CONFIG_DEVICE_NAME="ESPX"
CONFIG_MFG_TEST_GPIO=-1
CONFIG_LED_GPIO=-1
CONFIG_LED_STRIP_LENGTH=1

# --- Flash: 16 MB ---
CONFIG_ESPTOOLPY_FLASH_SIZE="16MB"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM: 8 MB octal on the R16N8 module ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- Bluetooth (Wi-Fi provisioning BLE transport) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- HTTPS server (embedded IDF component) ---
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# --- TLS: keep the cert bundle for HTTPS OTA from public servers ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# --- Wi-Fi provisioning: BLE by default, security 1 (X25519 + PoP) ---
CONFIG_ESPX_PROV_TRANSPORT_BLE=y
CONFIG_ESPX_PROV_SECURITY_VERSION_1=y
CONFIG_ESPX_PROV_POP="abcd1234"
CONFIG_ESPX_PROV_SHOW_QR=y
CONFIG_ESPX_PROV_SHOW_POP_IN_QR=y
CONFIG_ESPX_PROV_RESET_ON_FAILURE=y
CONFIG_ESPX_PROV_CONNECTION_COUNT=5

# --- HTTP server: WebSocket support for the live-state endpoint (/ws) ---
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_MAX_FRAME_LEN=4096
CONFIG_HTTPD_WS_MAX_CLIENTS=4

# --- Default device seeded on a fresh node ---
CONFIG_ESPX_DEFAULT_WS2812=y
CONFIG_ESPX_DEFAULT_WS2812_ID="led"
CONFIG_ESPX_DEFAULT_WS2812_GPIO=48
CONFIG_ESPX_DEFAULT_WS2812_COUNT=1

# --- FreeRTOS runtime statistics: required to report CPU load ---
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# --- CPU: 240 MHz (default is 160). Cheaper handshakes and less jitter. ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# --- Wi-Fi: no power save, so HTTPS/WebSocket requests stay responsive ---
CONFIG_ESPX_WIFI_PS_NONE=y

# --- Network services ---
CONFIG_ESPX_NTP_SERVER="pool.ntp.org"
CONFIG_ESPX_TZ="CST-8"
CONFIG_ESPX_MDNS_ADVERTISE_MQTT=n
CONFIG_ESPX_WS_ENABLE=y

# --- MQTT: protocol 5.0 ---
# EMQX 6.x and every current broker speak MQTT 5; it adds reason codes (exact
# failure diagnosis instead of a bare 0x04/0x05), user properties, message
# expiry, shared subscriptions and topic aliases. 3.1.1 stays compiled in so a
# legacy broker can still be reached by clearing session.protocol_ver.
CONFIG_MQTT_PROTOCOL_5=y

# --- OTA rollback: allow rollback on boot failure ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Log level: INFO (use DEBUG for bring-up) ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ============================================================
#  Internal RAM budget
# ============================================================
# Internal RAM is 345 KB and is the pool that actually runs out: Wi-Fi,
# Bluetooth, TLS handshake state and PSA crypto all need it. PSRAM is 8 MB and
# nearly idle. The settings below move what can move, and trim what cannot.

# Task stacks allocated with xTaskCreateWithCaps() (see core/task_util.h).
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Wi-Fi and LWP buffers in PSRAM. ESP-IDF recommends this combination
# (octal PSRAM + ESP32-S3) and falls back to internal RAM when allocation fails.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Trim Wi-Fi buffer pools. The defaults are sized for throughput; this node
# exchanges small control messages with a handful of clients.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# Smaller TCP windows: the payloads are small JSON documents, and every byte of
# window is a buffer held in RAM.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
CONFIG_LWIP_UDP_RECVMBOX_SIZE=4

# Allocate the TLS record buffers only while a record is being processed,
# instead of holding a full pair per session for its lifetime. This selects
# MBEDTLS_ASYMMETRIC_CONTENT_LEN, which is why the IN/OUT content lengths above
# take effect.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# TLS record buffers live in PSRAM instead of internal RAM. Internal RAM (~250 KB)
# runs out fast; PSRAM has 8 MB. Without this, the 16 KB input record buffer alone
# consumes ~6% of internal RAM per TLS session, and a handful of concurrent sessions
# exhaust it — causing PSA_ERROR_INSUFFICIENT_MEMORY and the "session creation
# failed" / esp-tls-mbedtls -0x008D errors seen in heap.log.
#
# NOTE: large PSRAM buffers (>16 KB threshold) are already allocated from PSRAM
# via SPIRAM_MALLOC_ALWAYSINTERNAL, but the mbedtls session context itself and
# smaller allocations still land in internal RAM without this.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Reduce TLS record buffer from 16 KB (bulk-transfer default) to 4 KB.
# This device serves small JSON payloads; the extra 12 KB per session is wasted
# internal RAM that directly causes the handshake failures and memory exhaustion.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096

# NOT enabled, deliberately: MBEDTLS_DYNAMIC_FREE_CONFIG_DATA.
# Its own help text says "all certificate, private key and DHM data are freed so
# users should register certificate and private key to ssl config object again".
# An HTTPS server holds one ssl config for all connections and never re-registers
# the key, so enabling it lets the first handshake succeed and makes every later
# one fail with a fatal alert from the peer.
