# Copy to /etc/espx-bridge.env on the bridge host.
# Referenced by deploy/espx-bridge.service via EnvironmentFile=.
KAFKA_BOOTSTRAP=192.168.100.101:9092
KAFKA_TOPIC=espx-telemetry
TDENGINE_URL=http://testing.homelab.lan:6041
TDENGINE_USER=root
# taosdata is TDengine's factory default; change it in production.
TDENGINE_PASS=taosdata
TDENGINE_DB=espx
