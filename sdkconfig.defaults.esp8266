# ESP-IDF Configuration for NodeMCU-12F (ESP8266)

# Target chip
CONFIG_IDF_TARGET="esp8266"
CONFIG_IDF_TARGET_ESP8266=y

# Partition table (ESP8266 has limited flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp8266.csv"

# WiFi (ESP8266 only supports 2.4GHz b/g/n)
CONFIG_ESP8266_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP8266_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# MQTT
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TASK_STACK_SIZE=4096

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# System
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ESP8266 specific
CONFIG_ESP8266_CPU_FREQ_160=y
CONFIG_ESP8266_IRAM_SAFE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Disable features not supported by ESP8266
CONFIG_ESPTOOLPY_BAUD_921600B=
CONFIG_FLASHMODE_DIO=y
