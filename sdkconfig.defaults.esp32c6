# ESP-IDF Configuration for ESP32-C6

# Target chip
CONFIG_IDF_TARGET="esp32c6"
CONFIG_IDF_TARGET_ESP32C6=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32c3.csv"

# WiFi (ESP32-C6 supports 2.4GHz WiFi 6)
CONFIG_ESP32C6_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP32C6_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32C6_WIFI_TX_BUFFER_TYPE=1

# MQTT
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TASK_STACK_SIZE=4096

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# System
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ESP32-C6 specific - RISC-V CPU
CONFIG_ESP32C6_DEFAULT_CPU_FREQ_160=y

# BLE 5.0 support (ESP32-C6 has Bluetooth LE 5.0)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_LE_SMP_ENABLE=y

# USB CDC
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
