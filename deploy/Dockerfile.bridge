# ESPX Kafka -> TDengine bridge, containerised.
#
# Use this when the homelab host has a container runtime but you would rather
# not install Python and a systemd unit on the host itself.
#
# Build & run (from the repo root):
#   docker build -f deploy/Dockerfile.bridge -t espx-bridge .
#   docker run -d --name espx-bridge --restart unless-stopped \
#     -e KAFKA_BOOTSTRAP=192.168.100.101:9092 \
#     -e TDENGINE_URL=http://testing.homelab.lan:6041 \
#     -e TDENGINE_USER=root -e TDENGINE_PASS=taosdata -e TDENGINE_DB=espx \
#     -v espx-bridge-state:/var/lib/espx \
#     espx-bridge
#
# Note: the bridge rewrites the broker's advertised container hostname
# (1Panel-kafka-cq1x) to a routable IP -- see the top of kafka_to_tdengine.py.
# If the container can resolve that name directly, that patch is a no-op.

FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir kafka-python

COPY tools/kafka_to_tdengine.py /app/kafka_to_tdengine.py

# Offsets live on a volume so a container restart resumes instead of replaying.
RUN mkdir -p /var/lib/espx
VOLUME ["/var/lib/espx"]

ENV PYTHONUNBUFFERED=1 \
    BRIDGE_OFFSETS=/var/lib/espx/offsets.json

CMD ["python3", "-u", "/app/kafka_to_tdengine.py", "--verbose"]
