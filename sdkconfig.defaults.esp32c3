# ESP-IDF Configuration for ESP32-C3 Super Mini

# Target chip
CONFIG_IDF_TARGET="esp32c3"
CONFIG_IDF_TARGET_ESP32C3=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32c3.csv"

# WiFi (ESP32-C3 uses IEEE 802.11b/g/n)
CONFIG_ESP32C3_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP32C3_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32C3_WIFI_TX_BUFFER_TYPE=1

# MQTT
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TASK_STACK_SIZE=4096

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# System - ESP32-C3 typical settings
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ESP32-C3 specific - RISC-V CPU
CONFIG_ESP32C3_DEFAULT_CPU_FREQ_160=y

# Enable RNG for security
CONFIG_ESP_RANDOM_ENABLE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# BLE support (ESP32-C3 has Bluetooth LE only)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# USB CDC (ESP32-C3-S3 has native USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
